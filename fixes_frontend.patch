diff --git a/frontend/src/services/warehouse.service.js b/frontend/src/services/warehouse.service.js
new file mode 100644
index 0000000..c590dce
--- /dev/null
+++ b/frontend/src/services/warehouse.service.js
@@ -0,0 +1,21 @@
+import api from "./api";
+
+const BASE = "/api/warehouses";
+
+export const warehouseService = {
+  async getAll(params = {}) {
+    return (await api.get(BASE, { params })).data;
+  },
+  async getById(id) {
+    return (await api.get(`${BASE}/${id}`)).data;
+  },
+  async create(data) {
+    return (await api.post(BASE, data)).data;
+  },
+  async update(id, data) {
+    return (await api.put(`${BASE}/${id}`, data)).data;
+  },
+  async remove(id) {
+    return (await api.delete(`${BASE}/${id}`)).data;
+  },
+};
